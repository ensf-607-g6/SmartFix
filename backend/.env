# Database Connection (local Postgres 17 + PostGIS on 5433; a Supabase URL works too)
DATABASE_URL=postgresql://localhost:5433/smartfix

# RabbitMQ (local broker; a CloudAMQP amqps:// URL works too). Empty = in-process bus.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

#OLLAMA
OLLAMA_URL=http://localhost:11434
# qwen3-vl:8b is the "thinking" build (20-30 s per photo); the instruct build answers in ~2 s (NFR-1).
VISION_MODEL=qwen3-vl:8b-instruct
FALLBACK_MODEL=gemma3:4b

# Auth
JWT_SECRET=wa0CTbDDT5lSKZLumhEqkVicPNEp1uMo8T41j-mwrUI

# Seconds between deadline / auto-close checks
SCHEDULER_INTERVAL_S=30

# Staff-only buttons to expire a deadline or the 7-day window (testing FR-10 / FR-11)
ENABLE_DEV_TOOLS=true
